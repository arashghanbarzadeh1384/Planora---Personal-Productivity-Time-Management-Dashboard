# Required in production: PostgreSQL connection string.
DATABASE_URL="postgresql://planora:change-me@localhost:5432/planora?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth provider. Omit both to use credentials sign-in only.
GITHUB_ID=""
GITHUB_SECRET=""

# Required only if you enable password-reset email delivery.
RESEND_API_KEY=""
EMAIL_FROM="Planora <noreply@example.com>"
