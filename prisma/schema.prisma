generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum RepeatRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum NotificationKind {
  REMINDER
  SUCCESS
  INFO
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  timezone         String          @default("UTC")
  theme            String          @default("system")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  tasks            Task[]
  schedules        Schedule[]
  events           Event[]
  habits           Habit[]
  goals            Goal[]
  focusSessions    FocusSession[]
  notes            Note[]
  tags             Tag[]
  notifications    Notification[]
  passwordResets   PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expires])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  color       String        @default("#6958e6")
  startDate   DateTime?
  deadline    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notes       Note[]
  @@index([userId, status])
  @@index([userId, deadline])
}

model Task {
  id               String     @id @default(cuid())
  userId           String
  projectId        String?
  title            String
  description      String?    @db.Text
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  startDate        DateTime?
  dueDate          DateTime?
  estimatedMinutes Int?
  actualMinutes    Int        @default(0)
  recurrence       RepeatRule @default(NONE)
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags             TaskTag[]
  focusSessions    FocusSession[]
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId])
}

model Schedule {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?    @db.Text
  startAt     DateTime
  endAt       DateTime
  category    String?
  color       String     @default("#6958e6")
  priority    Priority   @default(MEDIUM)
  location    String?
  notes       String?    @db.Text
  repeat      RepeatRule @default(NONE)
  reminderAt  Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startAt])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime
  location    String?
  color       String   @default("#2d9bf0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startAt])
}

model Habit {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?      @db.Text
  frequency   String       @default("daily")
  target      Int          @default(1)
  reminderAt  String?
  color       String       @default("#6958e6")
  icon        String       @default("CircleCheck")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     HabitEntry[]
  @@unique([userId, name])
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  completedAt DateTime @default(now())
  value     Int      @default(1)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, completedAt])
  @@index([habitId, completedAt])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?    @db.Text
  category    String?
  status      GoalStatus @default(ACTIVE)
  startDate   DateTime?
  deadline    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  @@index([userId, status])
}

model Milestone {
  id          String   @id @default(cuid())
  goalId      String
  title       String
  description String?  @db.Text
  completedAt DateTime?
  position    Int      @default(0)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@index([goalId, position])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  startedAt DateTime
  endedAt   DateTime
  minutes   Int
  label     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([userId, startedAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags      NoteTag[]
  @@index([userId, updatedAt])
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("#6958e6")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  notes     NoteTag[]
  @@unique([userId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([taskId, tagId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([noteId, tagId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind @default(INFO)
  title     String
  body      String?          @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
